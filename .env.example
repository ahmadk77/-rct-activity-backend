PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rct_activity_db
DB_USER=postgres
DB_PASSWORD=your_password
JWT_SECRET=your_jwt_secret_key
ENCRYPTION_KEY=your_32_byte_encryption_key
FEATURE_AI_MESSAGES=true
FEATURE_FAMILY_COACH=true
FEATURE_GAMIFICATION=true
FEATURE_VIDEO_LIBRARY=true

# Gemini Configuration (for AI-generated messages)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MAX_TOKENS=100
GEMINI_TEMPERATURE=0.7

# Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
# Or provide the path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json
